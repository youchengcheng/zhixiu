# ==========================================================
# 物业报修系统 .gitignore
# 技术栈：Spring Boot 3 + Vue 3 + Maven + Vite
# ==========================================================

# ========== 仅提交前后端工程（白名单）==========
# 根目录只放行 .gitignore、ZhiXiu-Cloud/、ZhiXiu-Vue3/，
# 文档、设计评审、源码备份、临时目录等一律不提交
/*
!/.gitignore
!/ZhiXiu-Cloud/
!/ZhiXiu-Vue3/

# ========== 工程内非交付内容 ==========
# AI 协作约定文件（前后端各自的 AGENTS.md）
**/AGENTS.md
# 后端开发规范文档与本机环境初始化脚本
/ZhiXiu-Cloud/docs/

# ========== Java / Maven ==========
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ========== 编译产物 ==========
build/
out/
bin/
*.o
*.so
*.dll
*.exe

# ========== IDE / 编辑器 ==========
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
out/
# Eclipse
.settings/
.project
.classpath
.factorypath
# VS Code
.vscode/
!.vscode/extensions.json
# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
# Vim
*.swp
*.swo
*~

# ========== 操作系统 ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========== 日志文件 ==========
logs/
log/
*.log
*.log.*
# logback 输出目录（文档中 LOG_HOME 默认 ./logs）
info/
error/

# ========== 环境变量 / 密钥（重点！严禁提交）==========
# 后端密钥配置
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
application-local.yml
application-local.yaml
application-local.properties
application-secret.yml
application-secret.yaml
*-secret.yml
*-secret.yaml

# 明文密钥 / 证书
*.pem
*.key
*.p12
*.jks
*.keystore
*.pfx
*.crt
*.cer
!src/main/resources/**/*.crt

# ========== Spring Boot 本地配置 ==========
# 允许提交 application.yml / dev / prod（无密钥，密钥走环境变量）
# 仅忽略本地个性化配置
src/main/resources/application-local.yml
src/main/resources/application-local.yaml
src/main/resources/application-local.properties

# ========== 前端 Node / Vite ==========
# 依赖
node_modules/
.npm/
.pnpm-store/
.yarn/
jspm_packages/
# 构建产物
dist/
dist-ssr/
.vite/
*.local
# 缓存
.cache/
.eslintcache
.stylelintcache
.parcel-cache
# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# 测试覆盖率
coverage/
*.lcov
.nyc_output/

# ========== 数据库 / 备份 ==========
*.sql.gz
*.sql.bak
*.dump
*.bak
*.backup
# 本地导出的测试数据（初始化 SQL 允许提交，见下方白名单）
!src/main/resources/db/*.sql

# ========== MinIO / 上传文件本地目录 ==========
uploads/
temp/
tmp/
minio-data/

# ========== RocketMQ / Redis 本地数据 ==========
rocketmq-store/
rocketmq/logs/
redis-data/
dump.rdb
appendonly.aof
*.rdb
*.aof

# ========== 文档 / 演示临时文件 ==========
*.tmp
*.temp
*.swp
~$*.docx
~$*.xlsx
~$*.pptx
*.orig
*.rej

# ========== 打包 / 部署产物 ==========
*.tar
*.tar.gz
*.zip
*.7z
*.rar
release/
deploy/
docker-compose.override.yml

# ========== 但保留必要的文件 ==========
!.gitignore
!README.md
!LICENSE
!.gitkeep
!**/.gitkeep